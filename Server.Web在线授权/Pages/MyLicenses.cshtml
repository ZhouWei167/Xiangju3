@page
@model Server.Web.Pages.MyLicensesModel
@{
    ViewData["Title"] = "我的授权记录";
}

<div class="container mt-4">
    <h2>我的授权记录</h2>
    <hr />

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>硬件ID</th>
                    <th>客户名称</th>
                    <th>产品名称</th>
                    <th>过期时间</th>
                    <th>签发时间</th>
                    <th>版本</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody id="recordsTable">
                <!-- 数据将通过JavaScript动态加载 -->
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <div>
            总记录数: <span id="totalRecords">0</span>
        </div>
        <nav aria-label="Page navigation">
            <ul class="pagination" id="pagination">
                <!-- 分页将通过JavaScript动态加载 -->
            </ul>
        </nav>
    </div>

    <!-- 记录详情模态框 -->
    <div class="modal fade" id="recordDetailModal" tabindex="-1" aria-labelledby="recordDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="recordDetailModalLabel">授权记录详情</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <pre id="recordDetail" class="border p-3" style="max-height: 400px; overflow-y: auto;"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">关闭</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 当前页码和每页记录数
        let currentPage = 1;
        const pageSize = 10;
        let totalPages = 0;

        // 页面加载完成后执行
        document.addEventListener('DOMContentLoaded', function () {
            // 加载授权记录
            loadMyLicenseRecords();
        });

        // 加载我的授权记录
        function loadMyLicenseRecords() {
            fetch(`/api/License/GetMyLicenseRecords?page=${currentPage}&pageSize=${pageSize}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(err => { throw new Error(err.message || '获取授权记录失败'); });
                }
                return response.json();
            })
            .then(data => {
                renderRecords(data.records);
                renderPagination(data.total, data.page, data.pageSize);
            })
            .catch(error => {
                console.error('获取授权记录失败:', error);
                alert('获取授权记录失败: ' + error.message);
            });
        }

        // 渲染授权记录
        function renderRecords(records) {
            const tableBody = document.getElementById('recordsTable');
            tableBody.innerHTML = '';

            if (records.length === 0) {
                const row = document.createElement('tr');
                row.innerHTML = '<td colspan="8" class="text-center">没有找到授权记录</td>';
                tableBody.appendChild(row);
                return;
            }

            records.forEach(record => {
                const row = document.createElement('tr');
                
                // 格式化日期
                const expirationDate = new Date(record.expiration_date).toLocaleString();
                const issueDate = new Date(record.issue_date).toLocaleString();
                
                row.innerHTML = `
                    <td>${record.id}</td>
                    <td>${record.hardware_id}</td>
                    <td>${record.customer_name || '-'}</td>
                    <td>${record.product_name || '-'}</td>
                    <td>${expirationDate}</td>
                    <td>${issueDate}</td>
                    <td>${record.version || '-'}</td>
                    <td>
                        <button class="btn btn-sm btn-info view-btn" data-record='${JSON.stringify(record)}'>查看</button>
                    </td>
                `;
                tableBody.appendChild(row);
            });

            // 添加查看按钮事件
            document.querySelectorAll('.view-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const record = JSON.parse(this.getAttribute('data-record'));
                    showRecordDetail(record);
                });
            });
        }

        // 渲染分页
        function renderPagination(total, page, pageSize) {
            const pagination = document.getElementById('pagination');
            pagination.innerHTML = '';
            
            document.getElementById('totalRecords').textContent = total;
            
            totalPages = Math.ceil(total / pageSize);
            if (totalPages <= 1) return;
            
            // 上一页
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${page === 1 ? 'disabled' : ''}`;
            prevLi.innerHTML = `<a class="page-link" href="#" ${page > 1 ? `onclick="changePage(${page - 1}); return false;"` : ''}>上一页</a>`;
            pagination.appendChild(prevLi);
            
            // 页码
            const startPage = Math.max(1, page - 2);
            const endPage = Math.min(totalPages, page + 2);
            
            for (let i = startPage; i <= endPage; i++) {
                const pageLi = document.createElement('li');
                pageLi.className = `page-item ${i === page ? 'active' : ''}`;
                pageLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>`;
                pagination.appendChild(pageLi);
            }
            
            // 下一页
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${page === totalPages ? 'disabled' : ''}`;
            nextLi.innerHTML = `<a class="page-link" href="#" ${page < totalPages ? `onclick="changePage(${page + 1}); return false;"` : ''}>下一页</a>`;
            pagination.appendChild(nextLi);
        }

        // 切换页码
        function changePage(page) {
            currentPage = page;
            loadMyLicenseRecords();
        }

        // 显示记录详情
        function showRecordDetail(record) {
            // 格式化日期
            record.expiration_date = new Date(record.expiration_date).toLocaleString();
            record.issue_date = new Date(record.issue_date).toLocaleString();
            record.created_at = new Date(record.created_at).toLocaleString();
            
            // 解析自定义数据
            if (record.custom_data) {
                try {
                    record.custom_data = JSON.parse(record.custom_data);
                } catch (e) {
                    // 如果解析失败，保持原样
                }
            }
            
            document.getElementById('recordDetail').textContent = JSON.stringify(record, null, 2);
            
            // 使用Bootstrap的Modal API显示模态框
            const modal = new bootstrap.Modal(document.getElementById('recordDetailModal'));
            modal.show();
        }
    </script>
} 