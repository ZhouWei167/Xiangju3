@page
@model Server.Web.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "访问被拒绝";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">访问被拒绝</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill"></i> 您没有权限访问此页面。
                    </div>
                    
                    <h5 class="mt-4">可能的原因：</h5>
                    <ul>
                        <li>您的账户没有被分配相应的权限组</li>
                        <li>您尝试访问的功能需要管理员权限</li>
                        <li>您的账户权限配置有误</li>
                    </ul>
                    
                    <h5 class="mt-4">建议操作：</h5>
                    <ol>
                        <li>返回<a href="/">首页</a>查看您当前拥有的权限</li>
                        <li>如果您确信应该有权限访问此页面，请联系系统管理员</li>
                        <li>尝试<a href="/Account/Logout">退出登录</a>并重新登录</li>
                    </ol>
                    
                    <div class="mt-4 d-flex gap-2">
                        <a href="/" class="btn btn-primary">返回首页</a>
                        <a href="/Account/Logout" class="btn btn-outline-secondary">退出登录</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 