<!DOCTYPE html>
<html lang="zh-cn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 伏羲授权</title>
    <!-- 使用CDN引用Bootstrap CSS，移除integrity属性 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <!-- 添加favicon链接，避免404错误，使用绝对路径 -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <!-- 内联CSS样式 -->
    <style>
        html {
          font-size: 14px;
        }
        
        @* 使用@@media代替@media来避免Razor解析错误 *@
        @@media (min-width: 768px) {
          html {
            font-size: 16px;
          }
        }
        
        html {
          position: relative;
          min-height: 100%;
        }
        
        body {
          margin-bottom: 60px;
        }
        
        .footer {
          position: absolute;
          bottom: 0;
          width: 100%;
          white-space: nowrap;
          line-height: 60px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">伏羲授权</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">首页</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            @inject Server.Web.Models.Auth.AuthService AuthService
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/License">授权文件生成</a>
                            </li>
                            @if (AuthService.CanCurrentUserViewRecords())
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/LicenseRecords">授权记录管理</a>
                                </li>
                            }
                            @if (AuthService.CanCurrentUserManageUsers())
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/UserManagement">用户管理</a>
                                </li>
                            }
                            @if (AuthService.IsCurrentUserSuperAdmin())
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/GroupManagement">用户组管理</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/MyLicenses">我的授权记录</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-dark">欢迎，@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Account/Logout">登出</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Account/Login">登录</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Account/Register">注册</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - 伏羲授权 - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <!-- 使用CDN引用Bootstrap JS，移除integrity属性 -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- 内联JS脚本 -->
    <script>
        // 站点JavaScript文件
        console.log("站点JavaScript已加载");
        
        // 添加错误处理代码，捕获资源加载失败
        window.addEventListener('error', function(e) {
            if (e.target.tagName === 'LINK' || e.target.tagName === 'SCRIPT') {
                console.error('资源加载失败:', e.target.src || e.target.href);
            }
        }, true);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>