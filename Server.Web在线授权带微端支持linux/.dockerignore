# 忽略git相关文件
.git
.gitignore
.gitattributes

# 忽略开发环境文件
.vs/
.vscode/
*.user
*.suo
*.userprefs
*.sln.docstates

# 忽略构建输出
bin/
obj/
临时工作目录/

# 忽略日志文件
logs/
*.log

# 忽略Docker相关文件
Dockerfile
docker-compose.yml
.dockerignore

# 忽略文档
*.md
LICENSE
README.md

# 忽略测试文件
**/Tests/
**/test/
**/tests/
**/*.Tests/

# 忽略其他不需要的文件
**/*.bak
**/*.tmp
**/*.swp 