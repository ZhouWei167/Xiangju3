<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Client</RootNamespace>
    <AssemblyName>Mir3</AssemblyName>
    <ApplicationIcon>Mir3Game.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>

    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <DefineConstants>CLIENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Desktop" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D9" Version="4.2.0" />
    <PackageReference Include="SharpDX.DirectSound" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Sentry" Version="3.14.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Library\Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Controls\*.cs" />
    <Compile Include="Envir\*.cs" />
    <Compile Include="Extentions\*.cs" />
    <Compile Include="Models\*.cs" />
    <Compile Include="Models\ParticleSystem\*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="TargetForm.cs" />
    <Compile Include="Scenes\Configs\*.cs" />
    <Compile Include="Scenes\GameScene.cs" />
    <Compile Include="Scenes\ServerListScene.cs" />
    <Compile Include="Scenes\LoadScene.cs" />
    <Compile Include="Scenes\LoginScene.cs" />
    <Compile Include="Scenes\SelectScene.cs" />
    <Compile Include="Scenes\ServerScene.cs" />
    <Compile Include="Scenes\StartScene.cs" />
    <Compile Include="Scenes\Views\*.cs" />
    <Compile Include="Scenes\Views\BigPatch\*.cs" />
    <Compile Include="UserModels\*.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" />
    <Compile Include="Properties\Settings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TargetForm.resx" />
    <EmbeddedResource Include="Properties\Resources.resx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Mir3Game.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
